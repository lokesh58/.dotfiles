[Unit]
Description=llama.cpp Server
After=network.target

[Service]
Type=exec
Environment="GGUF_ROOT=%h/local-llms/gguf"
ExecStartPre=%h/.local/bin/llama-preset-gen.sh ${GGUF_ROOT} %t/llama-models.ini
ExecStart=/usr/bin/llama-server \
    --host 127.0.0.1 \
    --port 9931 \
    --models-dir ${GGUF_ROOT} \
    --models-preset %t/llama-models.ini \
    --sleep-idle-seconds 300 \
    --fit-ctx 32768 \
    --flash-attn auto
Restart=on-failure
RestartSec=5
SyslogIdentifier=llama-server

[Install]
WantedBy=default.target
