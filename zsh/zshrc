#
# ~/.zshrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt INC_APPEND_HISTORY

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# OS-specific config
if [ -f ~/.dotfiles/zsh/zshrc.os ]; then
    source ~/.dotfiles/zsh/zshrc.os
fi

# Completions
autoload -Uz compinit
compinit

# Plugins
if [ -n "$ZSH_PLUGIN_DIR" ]; then
    source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
    source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Starship prompt
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# Rust Cargo binaries
if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# User local binaries (uv, pipx, etc.)
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Node (fnm)
if command -v fnm &> /dev/null; then
    eval "$(fnm env --use-on-cd --shell zsh)"
fi

# Zoxide
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# Environment Variables
if command -v nvim &> /dev/null; then
    export EDITOR=nvim
fi

# Local config (machine-specific, not tracked)
if [ -f ~/.dotfiles/zsh/zshrc.local ]; then
    source ~/.dotfiles/zsh/zshrc.local
fi
