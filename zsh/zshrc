#
# ~/.zshrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt INC_APPEND_HISTORY

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# OS-specific config (sets ZSH_PLUGIN_DIR and ZSH_P10K_PATH)
if [ -f ~/.dotfiles/zsh/zshrc.os ]; then
    source ~/.dotfiles/zsh/zshrc.os
fi

# Plugins
if [ -n "$ZSH_PLUGIN_DIR" ]; then
    source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
    source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Powerlevel10k theme
if [ -n "$ZSH_P10K_PATH" ]; then
    source "$ZSH_P10K_PATH"
fi

# To customize prompt, run `p10k configure` or edit ~/.dotfiles/zsh/p10k.zsh
if [ -f ~/.dotfiles/zsh/p10k.zsh ]; then
    source ~/.dotfiles/zsh/p10k.zsh
fi

# Local config (machine-specific, not tracked)
if [ -f ~/.dotfiles/zsh/zshrc.local ]; then
    source ~/.dotfiles/zsh/zshrc.local
fi
