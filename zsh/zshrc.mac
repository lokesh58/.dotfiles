# macOS-specific zsh config
# Managed via Homebrew

export ZSH_PLUGIN_DIR="$(brew --prefix)/share"
export ZSH_P10K_PATH="$(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme"

# Bitwarden SSH agent
export SSH_AUTH_SOCK="$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"
